# Root Environment Configuration Example

# Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Backend Configuration
PORT=5001
NODE_ENV=development

# Database (Local SQLite for dev / PostgreSQL for prod)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_12345!
JWT_EXPIRES_IN=7d

# Storage Configuration (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Default User Storage Limit in Bytes (5 GB = 5368709120)
DEFAULT_STORAGE_LIMIT_BYTES=5368709120
